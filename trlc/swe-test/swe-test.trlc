package SwTests

import Generic
import SwRequirements

section "SW-Tests" {

    Generic.Info sw_test_info_about_sw_test {
        description = "This file contains the software test cases for the flashcontainer tools. There is one test case per pytest test function in the 'tests' folder: the test function test_<name> implements the test case tc_<name>. The test result report relates the pytest results to the test cases by this naming rule."
    }

    section "Data Conversion" {

        SwTestCase tc_convert_valstr_to_byte {
            description = "This test case checks the conversion of integer and floating point parameter values into their byte representation in little and big endian byte order (tests/test_byteconv.py)."
            verifies = [SwRequirements.sw_req_data_types]
        }

        SwTestCase tc_bytes_to_c_init {
            description = "This test case checks the conversion of integer, floating point and UTF-8 values and arrays into C initializer text in both byte orders (tests/test_byteconv.py)."
            verifies = [SwRequirements.sw_req_data_types, SwRequirements.sw_req_output_csrc]
        }

        SwTestCase tc_swap {
            description = "This test case checks the byte swapping of the CRC input data for the access sizes 8, 16, 32 and 64 bit (tests/test_checksum.py)."
            verifies = [SwRequirements.sw_req_crc]
        }

        SwTestCase tc_str {
            description = "This test case checks the default CRC configuration and its text representation (tests/test_checksum.py)."
            verifies = [SwRequirements.sw_req_crc]
        }
    }

    section "Data Model" {

        SwTestCase tc_parameter_as_gap {
            description = "This test case checks the creation of gap fill parameters with the requested offset, length and fill pattern (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_header_bytes {
            description = "This test case checks the byte representation of a block header in little and big endian byte order (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_block_crc {
            description = "This test case checks the CRC calculation of a block parameter over a memory range against the CRC-32 check value in both byte orders (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_crc]
        }

        SwTestCase tc_get_bytes_empty {
            description = "This test case checks that an empty block without header produces no data (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_get_bytes {
            description = "This test case checks the memory image of a block with header and parameters (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_get_bytes_with_gaps {
            description = "This test case checks that gaps between parameters are filled with the block fill byte (tests/test_datamodel.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_model_str {
            description = "This test case checks the text representation of the data model elements used in log and error messages (tests/test_datamodel.py). It covers diagnostics only and verifies no software requirement."
            verifies = []
        }
    }

    section "Model Validation" {

        SwTestCase tc_load_example {
            description = "This test case checks that a valid example definition passes the model validation (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_dublicate_block_name {
            description = "This test case checks that duplicate block names are detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_overlapping_block {
            description = "This test case checks that overlapping blocks are detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_dublicate_parameter_name {
            description = "This test case checks that duplicate parameter names are detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_overlapping_parameter {
            description = "This test case checks that overlapping parameters are detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_parameter_exceed_range {
            description = "This test case checks that a parameter exceeding the end of its block is detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_parameter_outofrange {
            description = "This test case checks that a parameter located outside of its block is detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_parameter_header_overlap {
            description = "This test case checks that a parameter overlapping the block header is detected as validation error (tests/test_model_validate.py)."
            verifies = [SwRequirements.sw_req_model_validation]
        }
    }

    section "XML Parser" {

        SwTestCase tc_parse_int {
            description = "This test case checks the parsing of decimal and hexadecimal numbers from the XML definition, and the rejection of invalid numbers (tests/test_xmlparser.py)."
            verifies = [SwRequirements.sw_req_xml_input]
        }

        SwTestCase tc_calc_addr {
            description = "This test case checks the calculation of absolute addresses from numeric and relative ('.') offsets with alignment (tests/test_xmlparser.py)."
            verifies = [SwRequirements.sw_req_memory_layout]
        }

        SwTestCase tc_parse_invalid_xml {
            description = "This test case checks that a schema violating XML definition is rejected (tests/test_xmlparser.py)."
            verifies = [SwRequirements.sw_req_xml_schema_validation]
        }

        SwTestCase tc_parse_safety_example {
            description = "This test case checks that the safety example definition is parsed into the expected data model: container, block with header and fill byte, float array parameter, gap and CRC parameter (tests/test_xmlparser.py)."
            verifies = [SwRequirements.sw_req_xml_input, SwRequirements.sw_req_memory_layout, SwRequirements.sw_req_data_types, SwRequirements.sw_req_crc]
        }

        SwTestCase tc_modify_value {
            description = "This test case checks that a parameter value is replaced by a modification value given by parameter name (tests/test_xmlparser.py)."
            verifies = [SwRequirements.sw_req_modify_value]
        }
    }

    section "pargen" {

        SwTestCase tc_pargen_errors {
            description = "This test case checks the pargen result codes for a valid definition, a schema violating definition, a missing file and a definition failing the model validation (tests/test_pargen.py)."
            verifies = [SwRequirements.sw_req_exit_code, SwRequirements.sw_req_xml_schema_validation, SwRequirements.sw_req_model_validation]
        }

        SwTestCase tc_pargen_output {
            description = "This test case runs pargen with all writers on the Arduino example and compares the generated Intel HEX data and its CRC32 file with reference values (tests/test_pargen.py)."
            verifies = [SwRequirements.sw_req_output_ihex]
        }
    }

    section "tc3xx" {

        SwTestCase tc_tc3xx_abmhd_output {
            description = "This test case runs 'tc3xx abmhd' on a reference HEX file and compares the generated pargen XML definition with a reference (tests/test_tc3xx_abmhd.py)."
            verifies = [SwRequirements.sw_req_tc3xx_abmhd]
        }
    }
}
